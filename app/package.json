{
  "name": "thebigweather",
  "productName": "TheBigWeather",
  "version": "0.5.1",
  "description": "Radar and weather workstation",
  "author": "TheBigWeather",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prep-geo": "node scripts/prep-geo.mjs",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:all": "npm run build && electron-builder --linux AppImage --win nsis portable --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.3",
    "@tmcw/togeojson": "^7.1.3",
    "@types/topojson-client": "^3.1.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "hls.js": "^1.7.3",
    "idb-keyval": "^6.3.0",
    "lucide-preact": "^1.55.0",
    "maplibre-gl": "^6.13.0",
    "preact": "^11.0.1",
    "satellite.js": "^6.0.2",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "us-atlas": "^3.0.1",
    "vite": "^8.3.4",
    "world-atlas": "^2.0.2"
  },
  "build": {
    "appId": "app.thebigweather.desktop",
    "productName": "TheBigWeather",
    "artifactName": "TheBigWeather-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Science",
      "icon": "build/icon.png",
      "synopsis": "Radar and weather workstation",
      "executableName": "thebigweather",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "../server/bin/tbw-server",
          "to": "server/tbw-server"
        }
      ]
    },
    "appImage": {
      "artifactName": "TheBigWeather-${version}-x86_64.AppImage"
    },
    "publish": null,
    "fileAssociations": [
      {
        "ext": "pal",
        "name": "Radar color table",
        "description": "Radar color table (.pal)",
        "role": "Editor",
        "mimeType": "application/x-tbw-colortable"
      },
      {
        "ext": "tbwws",
        "name": "TheBigWeather workspace",
        "description": "TheBigWeather workspace",
        "role": "Editor",
        "mimeType": "application/x-tbw-workspace"
      },
      {
        "ext": "ar2v",
        "name": "NEXRAD Level II volume",
        "description": "NEXRAD Level II radar volume",
        "role": "Viewer",
        "mimeType": "application/x-nexrad-level2"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "TheBigWeather",
      "extraResources": [
        {
          "from": "../server/bin/tbw-server.exe",
          "to": "server/tbw-server.exe"
        },
        {
          "from": "../server/bin/ffmpeg.exe",
          "to": "server/ffmpeg.exe"
        },
        {
          "from": "../server/bin/yt-dlp.exe",
          "to": "server/yt-dlp.exe"
        }
      ],
      "signAndEditExecutable": true,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "TheBigWeather-${version}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TheBigWeather",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "TheBigWeather-${version}-portable.${ext}"
    }
  },
  "desktopName": "thebigweather.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/goglesquirmintontheiii/thebigweather.git"
  }
}
